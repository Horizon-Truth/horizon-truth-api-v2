DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=horizon_truth
PORT=3000
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development



# Outgoing email (required to reply to contact submissions)
# MAIL_FROM must use a domain verified in your Resend dashboard.
# For testing without a verified domain, use: Horizon <onboarding@resend.dev>
RESEND_API_KEY=
MAIL_FROM="Horizon <contact@horizontruth.org>"

# Frontend origin for password-reset links (e.g. http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# AI verification for crowdsourced reports. Both are optional — the defaults
# below are used when unset. Reports are never blocked by this service being
# slow or unavailable; failed attempts are recorded and can be retried.
# AI_VERIFICATION_URL=https://ai.horizontruth.org/api/detect
# AI_VERIFICATION_TIMEOUT_MS=30000

# Account deletion & inactivity (all values in days)
# Recovery window after a user deletes their account; they can restore it by signing in.
ACCOUNT_DELETION_GRACE_DAYS=30
# Player accounts with no sign-in or API use for this long are deleted. Never based on account age.
INACTIVE_ACCOUNT_DAYS=730
# Email notice sent this long before an inactive account is deleted. No notice = no deletion.
INACTIVE_ACCOUNT_NOTICE_DAYS=30
# Background job (erasures + notices). Set to false to disable on this instance.
ACCOUNT_LIFECYCLE_JOB_ENABLED=true
ACCOUNT_LIFECYCLE_INTERVAL_HOURS=6
