DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=horizon_truth
PORT=3000
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development



# Outgoing email (required to reply to contact submissions)
# MAIL_FROM must use a domain verified in your Resend dashboard.
# For testing without a verified domain, use: Horizon <onboarding@resend.dev>
RESEND_API_KEY=
MAIL_FROM="Horizon <contact@horizontruth.org>"

# AI verification for crowdsourced reports. Both are optional — the defaults
# below are used when unset. Reports are never blocked by this service being
# slow or unavailable; failed attempts are recorded and can be retried.
# AI_VERIFICATION_URL=https://ai.horizontruth.org/api/detect
# AI_VERIFICATION_TIMEOUT_MS=30000
